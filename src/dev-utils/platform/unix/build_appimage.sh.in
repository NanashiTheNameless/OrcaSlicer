#!/usr/bin/env bash
set -euo pipefail

APPIMAGETOOLURL="https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-$(uname -m).AppImage"
REPO_ROOT="@CMAKE_SOURCE_DIR@"


APP_IMAGE="@SLIC3R_APP_KEY@_Linux_V@SoftFever_VERSION@.AppImage"

wget --tries=5 --waitretry=5 --timeout=60 --retry-connrefused \
  --retry-on-http-error=429,500,502,503,504 \
  "${APPIMAGETOOLURL}" -O ../appimagetool.AppImage.part
mv ../appimagetool.AppImage.part ../appimagetool.AppImage
chmod +x ../appimagetool.AppImage

if [ -f /.dockerenv ] ; then # Only run if inside of a Docker Container
sed '0,/AI\x02/{s|AI\x02|\x00\x00\x00|}' -i  ../appimagetool.AppImage
fi

mv @SLIC3R_APP_CMD@ AppRun
chmod +x AppRun

cp resources/images/@SLIC3R_APP_KEY@_192px.png @SLIC3R_APP_KEY@.png
mkdir -p usr/share/icons/hicolor/192x192/apps
cp resources/images/@SLIC3R_APP_KEY@_192px.png usr/share/icons/hicolor/192x192/apps/@SLIC3R_APP_KEY@.png
cat <<EOF > dev.namelessnanashi.@SLIC3R_APP_KEY@.desktop
[Desktop Entry]
Name=@SLIC3R_APP_KEY@
Exec=AppRun %F
Icon=@SLIC3R_APP_KEY@
Type=Application
PrefersNonDefaultGPU=true
X-KDE-RunOnDiscreteGpu=true
Categories=Utility;
MimeType=model/stl;application/vnd.ms-3mfdocument;application/prs.wavefront-obj;application/x-amf;
EOF

mkdir -p usr/share/applications
cp dev.namelessnanashi.@SLIC3R_APP_KEY@.desktop usr/share/applications/

mkdir -p usr/share/metainfo
cp "${REPO_ROOT}/scripts/flatpak/dev.namelessnanashi.@SLIC3R_APP_KEY@.metainfo.xml" \
  "usr/share/metainfo/dev.namelessnanashi.@SLIC3R_APP_KEY@.metainfo.xml"
cp "${REPO_ROOT}/scripts/flatpak/dev.namelessnanashi.@SLIC3R_APP_KEY@.metainfo.xml" \
  "usr/share/metainfo/dev.namelessnanashi.@SLIC3R_APP_KEY@.appdata.xml"


export ARCH=$(uname -m)

appimage_args=()
if [ -f /.dockerenv ] || [ -n "${container:-}" ]; then
  appimage_args+=(--appimage-extract-and-run)
fi
../appimagetool.AppImage "${appimage_args[@]}" .

mv "@SLIC3R_APP_KEY@-$(uname -m).AppImage" "${APP_IMAGE}"
chmod +x "${APP_IMAGE}"

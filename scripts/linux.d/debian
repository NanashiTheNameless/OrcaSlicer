#!/bin/bash

REQUIRED_DEV_PACKAGES=(
    autoconf
    automake
    build-essential
    cmake
    eglexternalplatform-dev
    extra-cmake-modules
    file
    g++
    gettext
    git
    gstreamer1.0-gtk3
    libcurl4-openssl-dev
    libdbus-1-dev
    libglew-dev
    libgtk-3-dev
    libmspack-dev
    libsecret-1-dev
    libspnav-dev
    libssl-dev
    libtool
    libudev-dev
    clang
    lld
    ninja-build
    texinfo
    wget
    pkgconf
    yasm
    nasm
)

if [[ -n "$UPDATE_LIB" ]]
then
    # shellcheck source=/dev/null
    source /etc/os-release
    # Refresh package metadata early so availability checks with `apt show` are reliable on fresh runners
    sudo apt update
    if [ "${ID}" == "ubuntu" ] && [ -n "${VERSION_ID}" ]; then
        # It's ubuntu and we have a VERSION_ID like "24.04".
        if dpkg --compare-versions "${VERSION_ID}" ge 22 && dpkg --compare-versions "${VERSION_ID}" lt 24 ; then
            # Some extra packages needed on Ubuntu 22.x and 23.x:
            REQUIRED_DEV_PACKAGES+=(curl libfuse-dev m4)
            # libgstreamer1.0-dev on 22.x depends on libunwind-dev; include it explicitly to avoid unmet deps
            REQUIRED_DEV_PACKAGES+=(libunwind-dev)
            # 22.x ships clang 14 by default. That toolchain has been observed to
            # mis-codegen some numeric code (e.g. flush-volume computation produces
            # much smaller purge amounts than the identical source built with the
            # clang 18 that 24.x ships). Pull in clang 18 from the official LLVM
            # apt repo so the build step can select it explicitly; see
            # build_linux.sh's use of ORCA_CLANG_VERSION.
            # `/etc/os-release` is already sourced above; reuse VERSION_CODENAME.
            llvm_codename=${VERSION_CODENAME}
            sudo wget -qO /usr/share/keyrings/llvm.asc https://apt.llvm.org/llvm-snapshot.gpg.key
            sudo gpg --dearmor -o /usr/share/keyrings/llvm.gpg /usr/share/keyrings/llvm.asc
            echo "deb [signed-by=/usr/share/keyrings/llvm.gpg] https://apt.llvm.org/${llvm_codename}/ llvm-toolchain-${llvm_codename}-18 main" | sudo tee /etc/apt/sources.list.d/llvm18.list
            sudo apt update
            REQUIRED_DEV_PACKAGES+=(clang-18)
        fi
    fi

    if [[ -n "$BUILD_DEBUG" ]]
    then
        REQUIRED_DEV_PACKAGES+=(libssl-dev libcurl4-openssl-dev)
    fi

    # Choose the appropriate GStreamer dev package based on availability
    if [ "$(apt show --quiet libgstreamerd-3-dev 2>/dev/null)" != "" ]; then
        REQUIRED_DEV_PACKAGES+=(libgstreamerd-3-dev)
    else
        REQUIRED_DEV_PACKAGES+=(libgstreamer1.0-dev)
    fi

    # Match CMake's preference for WebKit 4.1, with a 4.0 fallback.
    # The WebKit dev package pulls in the matching libsoup dev dependency.
    if [ "$(apt show --quiet libwebkit2gtk-4.1-dev 2>/dev/null)" != "" ]
    then
        REQUIRED_DEV_PACKAGES+=(libwebkit2gtk-4.1-dev)
    else
        REQUIRED_DEV_PACKAGES+=(libwebkit2gtk-4.0-dev)
    fi

    # install them all at once
    sudo apt install -y "${REQUIRED_DEV_PACKAGES[@]}"

    echo -e "done\n"
    exit 0
fi

export FOUND_GTK3_DEV
FOUND_GTK3_DEV=$(dpkg -l libgtk* | grep gtk-3-dev || echo '')
